# Copy to .env.local for local development.
# Never commit secrets. NEXT_PUBLIC_* values are exposed to the browser.

# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Postgres via the transaction-mode pooler (IPv4). Password: Supabase → Project Settings → Database.
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# fal.ai API key (server-only). fal.ai dashboard → Keys.
# FAL_KEY=

# Better Auth. Generate the secret with: openssl rand -base64 32
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000
